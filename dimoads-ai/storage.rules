rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper to check if file owner matches current authenticated user ID
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Match listing images inside: users/{uid}/listings/{listingId}/{fileName}
    match /users/{uid}/listings/{listingId}/{fileName} {
      allow read: if true; // Public marketplace visibility
      allow create, update: if isSignedIn() && isOwner(uid);
      allow delete: if isSignedIn() && isOwner(uid);
    }

    // Match user profile photos inside: users/{uid}/profile/{fileName}
    match /users/{uid}/profile/{fileName} {
      allow read: if true; // Public profile/trust badge visibility
      allow create, update: if isSignedIn() && isOwner(uid);
      allow delete: if isSignedIn() && isOwner(uid);
    }
  }
}
