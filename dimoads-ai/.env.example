# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration Keys
VITE_FIREBASE_PROJECT_ID="iconic-chord-9gbcx"
VITE_FIREBASE_APP_ID="1:582554855565:web:9f398f8f50c7f7bb181ac4"
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="iconic-chord-9gbcx.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="ai-studio-dimoadsai-fbe57882-84bd-443a-8715-bcf709428621"
VITE_FIREBASE_STORAGE_BUCKET="iconic-chord-9gbcx.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="582554855565"

# Edge CDN Domain (Optional, defaults to cdn.dimoads.com)
VITE_CDN_DOMAIN=

# Google OAuth (Optional — keep secrets out of VCS)
# Create a local `.env.local` (not committed) and set these values there.
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
# Google OAuth Client Secret: store this only in environment or secret manager.
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# Gemini / Google GenAI API key (server-side usage)
# Example: GEMINI_API_KEY="projects/...:locations/...:key/..." or the raw API key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase admin/service account (Optional for server-side Firestore access)
# Point to a JSON file path containing your service account credentials.
# Example: GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
